+        {
+            ThrowOnDraw = true,
+        };
+        var standalone = new TestBackend(PluginWindowPreviewBackendMode.Standalone);
+        var result = await PluginWindowPreviewBackendFactory.CreateAsync(
+            PluginWindowPreviewBackendMode.Auto,
